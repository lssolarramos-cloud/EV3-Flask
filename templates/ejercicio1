<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 1</title>

    <style>

        body{
            background-color: #e6e6e6;
            font-family: Arial;
        }

        .contenedor{
            width: 350px;
            background-color: white;
            margin: 50px auto;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        input{
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
        }

        button{
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
        }

    </style>

</head>

<body>

<div class="contenedor">

    <h2>Formulario de Notas</h2>

    <form method="POST">

        <label>Nota 1:</label>
        <input type="number" name="nota1" min="10" max="70" required>

        <label>Nota 2:</label>
        <input type="number" name="nota2" min="10" max="70" required>

        <label>Nota 3:</label>
        <input type="number" name="nota3" min="10" max="70" required>

        <label>Asistencia (%):</label>
        <input type="number" name="asistencia" min="0" max="100" required>

        <button type="submit">
            Enviar
        </button>

    </form>

    {% if promedio != 0 %}

        <h3>
            Promedio: {{ promedio }}
        </h3>

        <h3>
            Estado: {{ estado }}
        </h3>

    {% endif %}

    <br>

    <a href="/">Volver al inicio</a>

</div>

</body>
</html>
