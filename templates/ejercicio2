<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 2</title>

    <style>

        body{
            background-color: #e6e6e6;
            font-family: Arial;
        }

        .contenedor{
            width: 350px;
            background-color: white;
            margin: 50px auto;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
            text-align: center;
        }

        input{
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
        }

        button{
            background-color: #0d6efd;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
        }

    </style>

</head>

<body>

<div class="contenedor">

    <h2>Formulario de Nombres</h2>

    <form method="POST">

        <label>Nombre 1:</label>
        <input type="text" name="nombre1" required>

        <label>Nombre 2:</label>
        <input type="text" name="nombre2" required>

        <label>Nombre 3:</label>
        <input type="text" name="nombre3" required>

        <button type="submit">
            Enviar
        </button>

    </form>

    {% if nombre_mayor != "" %}

        <h3>
            El nombre con mayor cantidad de caracteres es:
            {{ nombre_mayor }}
        </h3>

        <h3>
            El nombre tiene:
            {{ cantidad }} caracteres
        </h3>

    {% endif %}

    <br>

    <a href="/">Volver al inicio</a>

</div>

</body>
</html>
